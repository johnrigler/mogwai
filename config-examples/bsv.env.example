# Canonical filesystem data root, normally /home/john/chisel_data on rigler.
# If Apache uses another directory for /chisel-data/, put that exact path here.
# Bash scripts and the Python CLI default to ~/chisel_data without this file.
# systemd EnvironmentFile needs an absolute path (no $HOME or ~ expansion).
CHISEL_DATA_ROOT=/home/john/chisel_data
BSV_EXPORT_DIR=/home/john/chisel_data/bsv
